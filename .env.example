# Telegram bot token issued by BotFather.
TG_TOKEN=
# Private Telegram chat ID of the person who approves proposals.
TG_CHAT=
# Full URL of the engine's POST /extract endpoint.
ENGINE_URL=
# Bearer token for the engine. Keep it server-side; never expose it to the browser.
ENGINE_TOKEN=
# Speaker name whose actions the engine should extract from the transcript.
PRINCIPAL=
# Transcript file path; defaults to web/sample.txt relative to the repository root.
TRANSCRIPT_PATH=
